# Clave que SGIT enviará en el header X-API-Key (genera una con: openssl rand -hex 32)
API_KEY=cambia_esto_por_una_clave_larga

# Impresora HP E52645 (IPP habilitado en Redes > Más configuraciones)
PRINTER_URI=ipp://192.168.1.134:631/ipp/print

MAX_MB=20            # tamaño máximo por PDF
MAX_ATTEMPTS=3       # reintentos si la impresora no responde
JOB_TIMEOUT_MIN=15   # si no termina en este tiempo, se marca failed
KEEP_FILES_HOURS=24  # se borran los PDF luego de este tiempo
